# Copy to .env (never committed) to enable the Home Assistant LED ring integration.
# Leave unset to skip it entirely — the app works fine without it.

# Home Assistant, reachable from the machine running server.js
HA_BASE_URL=http://homeassistant.local:8123
HA_TOKEN=

# HA script entity_ids to run for each event. Each script should activate the
# matching WLED preset on light.dojo_wled_dartboard. Defaults shown below —
# only override if you name your scripts differently.
# HA_SCRIPT_GAME_ON=script.dartboard_game_on
# HA_SCRIPT_GAME_OFF=script.dartboard_game_off
# HA_SCRIPT_WINNER=script.dartboard_winner
